# Application Data Mode: 'demo' (in-browser mock worker) or 'live' (real API backend)
VITE_DATA_MODE=demo

# Backend API Base URL (empty for relative path in demo, or e.g. http://localhost:3000 or Stoplight mock)
VITE_API_BASE_URL=

# Extended / Proposed Authentication Endpoint Path (e.g. /auth/login or /admin/login)
# If empty in live mode, shows clear integration notice on login page
VITE_AUTH_LOGIN_PATH=/auth/login

# Extended / Proposed Paginated Transactions Endpoint Path (e.g. /transactions)
# If empty in live mode, displays explicit contract missing / unavailable state
VITE_TRANSACTIONS_PATH=/transactions
